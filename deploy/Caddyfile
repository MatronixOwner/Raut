# Замените chat.example.ru на ваш домен, который ведёт на VPS.
# Caddy 2 сам получает и продлевает TLS-сертификат и проксирует WebSocket.
# HTTPS обязателен: getUserMedia / getDisplayMedia работают только в secure context.
{
	email admin@example.ru
}

chat.example.ru {
	encode zstd gzip
	reverse_proxy raut:8787 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
	}
	header {
		Strict-Transport-Security "max-age=31536000;"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
